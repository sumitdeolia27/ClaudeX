# Copy to .env and fill in. .env is gitignored.
# ClaudeX needs BOTH keys for real cross-vendor debate. With one key it
# degrades to self-critique and warns you. With neither it runs offline.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional: OpenAI organisation
# OPENAI_ORG_ID=org-...

# Optional: point a vendor at a proxy or gateway.
# Ambient ANTHROPIC_BASE_URL / OPENAI_BASE_URL are deliberately ignored,
# because host tools set those to internal proxies that reject plain API keys.
# CLAUDEX_CLAUDE_BASE_URL=https://api.anthropic.com
# CLAUDEX_GPT_BASE_URL=https://api.openai.com
