{
  "_comment": "Model registry. Code never hardcodes a model ID. Each vendor has two transports: 'api' (pay-as-you-go API key) and 'cli' (your Claude/Codex subscription via the local CLI). Pick with --via api|cli|auto.",
  "vendors": {
    "claude": {
      "api_key_env": "ANTHROPIC_API_KEY",
      "transports": {
        "api": {
          "provider": "anthropic",
          "base_url": "https://api.anthropic.com",
          "api_version": "2023-06-01"
        },
        "cli": {
          "provider": "cli",
          "command": [
            "claude",
            "-p"
          ],
          "model_flag": "--model",
          "check": [
            "claude",
            "--version"
          ],
          "login_hint": "claude login",
          "extra_args": []
        }
      },
      "tiers": {
        "deep": {
          "model": "claude-opus-5",
          "max_tokens": 8000,
          "price_in": 5.0,
          "price_out": 25.0,
          "thinking": true
        },
        "balanced": {
          "model": "claude-sonnet-5",
          "max_tokens": 8000,
          "price_in": 3.0,
          "price_out": 15.0,
          "thinking": false
        },
        "fast": {
          "model": "claude-haiku-4-5-20251001",
          "max_tokens": 4000,
          "price_in": 1.0,
          "price_out": 5.0,
          "thinking": false
        }
      }
    },
    "gpt": {
      "api_key_env": "OPENAI_API_KEY",
      "transports": {
        "api": {
          "provider": "openai",
          "base_url": "https://api.openai.com"
        },
        "cli": {
          "provider": "cli",
          "command": [
            "codex",
            "exec"
          ],
          "model_flag": "-m",
          "check": [
            "codex",
            "--version"
          ],
          "login_hint": "codex login  (choose 'Sign in with ChatGPT')",
          "extra_args": [
            "--skip-git-repo-check",
            "-s",
            "read-only",
            "--ephemeral",
            "--color",
            "never"
          ],
          "output_file_flag": "-o"
        }
      },
      "tiers": {
        "deep": {
          "model": "gpt-5.5-pro",
          "cli_model": "gpt-6-astra",
          "max_tokens": 8000,
          "price_in": 20.0,
          "price_out": 80.0,
          "reasoning_effort": "high"
        },
        "balanced": {
          "model": "gpt-5.5",
          "cli_model": "gpt-5.6-terra",
          "max_tokens": 8000,
          "price_in": 1.25,
          "price_out": 10.0,
          "reasoning_effort": "medium"
        },
        "fast": {
          "model": "gpt-5.4-mini",
          "cli_model": "gpt-5.6-luna",
          "max_tokens": 4000,
          "price_in": 0.25,
          "price_out": 2.0,
          "reasoning_effort": "low"
        }
      },
      "_price_warning": "Prices unverified - check platform.openai.com/pricing"
    }
  },
  "routing": {
    "_comment": "role + phase profile -> tier. Two roles are deliberately not cheap: `summarize`, because its output is the only view later phases get of an accepted section, and `judge`, because a judge below the author's tier cannot meaningfully reject its work.",
    "propose": {
      "deep": "deep",
      "standard": "balanced",
      "light": "fast"
    },
    "critique": {
      "deep": "deep",
      "standard": "balanced",
      "light": "balanced"
    },
    "revise": {
      "deep": "deep",
      "standard": "balanced",
      "light": "fast"
    },
    "judge": {
      "deep": "deep",
      "standard": "balanced",
      "light": "fast"
    },
    "summarize": {
      "deep": "balanced",
      "standard": "balanced",
      "light": "fast"
    },
    "assemble": {
      "deep": "deep",
      "standard": "balanced",
      "light": "balanced"
    },
    "profile": {
      "deep": "balanced",
      "standard": "balanced",
      "light": "fast"
    }
  },
  "escalation": {
    "_comment": "A phase scoring below escalate_below is retried one tier up.",
    "escalate_below": 70,
    "ladder": [
      "fast",
      "balanced",
      "deep"
    ]
  },
  "cli": {
    "_comment": "Subscription transport. Calls cost no money but are metered by your plan, so they are throttled and capped. max_calls_per_run is a runaway-loop safety net, not a budget: it is sized so the documented defaults (25 phases at --rounds 2, worst case 250 calls) can actually finish. `claudex run` prints the projection before spending anything.",
    "timeout": 600,
    "delay_between_calls": 2.0,
    "max_calls_per_run": 260,
    "warn_after_calls": 40
  }
}
